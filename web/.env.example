# Copy to .env for local use (node --env-file=.env server/index.js), or set these in your host's dashboard.
# Everything is optional for local development.

# --- server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Public address, used in emails and share links
APP_URL=https://vroomate.example.in
# Set both when the app is served over HTTPS behind a proxy (Render, Railway, Caddy, nginx)
VROOMATE_SECURE_COOKIE=1
TRUST_PROXY=1
# API requests per IP per minute
API_RATE_LIMIT=300

# --- storage ---
VROOMATE_DB=/data/vroomate.db
VROOMATE_UPLOADS=/data/uploads
VROOMATE_BACKUP=1
VROOMATE_BACKUP_DIR=/data/backups
VROOMATE_BACKUP_KEEP=14

# --- email (resend.com): password resets and ride alerts ---
MAIL_API_KEY=
MAIL_FROM=Vroomate <rides@vroomate.example.in>
# Shown on the terms and privacy pages
SUPPORT_EMAIL=help@vroomate.example.in

# --- SMS (twilio.com): phone verification codes ---
# Indian numbers need DLT registration of the sender and template with your telecom operator.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- push notifications: generate with `npm run vapid` ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:help@vroomate.example.in

# --- matching ---
RADAR_THRESHOLD=3
